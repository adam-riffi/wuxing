# Build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Secrets — the cfg holds the reference (${VAR}); .env holds the value, never committed
.env
.env.local

# wuxing runtime state
# scratch/ is per-agent ephemeral churn (swept each run); artifacts/local is dev output
scratch/
artifacts/local/

# Local SQLite fact/dim store
*.db
*.db-journal
*.db-wal
*.db-shm

# Editor / OS noise
.idea/
.vscode/
.DS_Store
Thumbs.db

# Go vendoring (we use the module cache, not vendored deps)
vendor/

# Authoring drafts of the design docs. The committed canonical copies live in
# docs/architecture/; context/ is the local staging area (see docs/architecture/README.md).
/context/

# Local coverage profiles
cov_*.out
