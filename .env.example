# wuxing secrets — 12-factor. Copy to .env and fill in values; .env is never committed.
# The cfg holds the reference (e.g. ${SCRYFALL_KEY}); this file holds the value.
# A tool references a secret; it never stores one.

# Scryfall API (MTG example service — Phase 7)
SCRYFALL_KEY=

# Discord webhook (messenger first-party service — Phase 6)
DISCORD_WEBHOOK=

# AI backend (ai tool — Codex CLI / OpenAI-compatible window)
OPENAI_API_KEY=

# AI agent mode (ai tool "agent" op) — drive a real agent CLI headlessly.
# wuxing runs WUXING_AI_AGENT_COMMAND in a scratch dir, hands it the brief, and
# captures the artifact. The process inherits this environment, so the CLI's own
# key (OPENAI_API_KEY / OPENROUTER_API_KEY / etc.) flows through. See
# docs/quickstart-ai-agent.md. Try it: wuxing agent --brief "..."
WUXING_AI_AGENT_COMMAND=           # e.g. hermes | codex | claude | od
WUXING_AI_AGENT_ARGS=              # extra args, space-split; {{brief}} {{model}} {{workdir}} expand
WUXING_AI_AGENT_PROMPT_VIA=stdin   # stdin | arg | file
WUXING_AI_AGENT_OUTPUT_VIA=stdout  # stdout | file
WUXING_AI_AGENT_OUTPUT_FILE=       # filename in the scratch dir when OUTPUT_VIA=file
WUXING_AI_AGENT_USAGE_FILE=        # optional JSON sidecar: {tokens_in,tokens_out,cost,turns}
WUXING_AI_AGENT_MODEL=             # default model label recorded on the fact
WUXING_AI_AGENT_TIMEOUT_SECONDS=   # per-session wall-clock bound (default 300)
# OpenRouter key for Hermes Agent (300+ models), if you use it:
OPENROUTER_API_KEY=

# Codex backend (wxg infer chat/agent ... codex) — wuxing calls the Codex CLI
# itself. Default invocation is `codex exec "<prompt>"`. Override here. Codex's
# own auth is read from this environment.
WUXING_CODEX_COMMAND=codex        # the codex binary (or absolute path)
WUXING_CODEX_ARGS=exec            # subcommand/flags; the prompt is appended as one arg
WUXING_CODEX_MODEL=               # model label recorded on the fact
WUXING_CODEX_TIMEOUT_SECONDS=     # per-call wall-clock bound (default 300)

# wuxing fact store. Leave WUXING_FACT_STORE_DSN empty to use embedded SQLite at
# WUXING_FACT_STORE_PATH; set it to a Postgres URL to use a server backend
# (local Postgres or Supabase) reachable from DBeaver/Tableau.
WUXING_FACT_STORE_PATH=~/.wuxing/wuxing.db
WUXING_FACT_STORE_DSN=
# e.g. postgres://USER:PASSWORD@HOST:5432/wuxing?sslmode=require   (Supabase: use the direct connection, port 5432)

# Service domain data — a connector's Postgres target (the cargo, e.g. mtg.cards).
DOMAIN_POSTGRES_DSN=
